		flex: 1;
		background-image: linear-gradient(to bottom, #67C23A, #A8DE8A 40%, #F4F6F3 40%, #F4F6F3);
		padding: 0 20px;
	}

	.brand {
		align-items: center;
		padding-top: 70px;
		padding-bottom: 24px;
	}

	.logo-circle {
		width: 68px;
		height: 68px;
		border-radius: 34px;
		background-color: #FFFFFF;
		align-items: center;
		justify-content: center;
	}

	.logo-text {
		font-size: 32px;
		font-weight: bold;
		color: #67C23A;
	}

	.brand-name {
		font-size: 22px;
		font-weight: bold;
		color: #FFFFFF;
		margin-top: 12px;
	}

	.brand-slogan {
		font-size: 13px;
		color: #F0FBEA;
		margin-top: 6px;
	}

	.form-card {
		background-color: #FFFFFF;
		border-radius: 14px;
		padding: 20px 16px;
		box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.06);
	}

	.form-title {
		font-size: 18px;
		font-weight: bold;
		color: #303133;
		margin-bottom: 16px;
	}

	.input-line {
		flex-direction: row;
		align-items: center;
		background-color: #F7F8FA;
		border-radius: 10px;
		height: 46px;
		padding-left: 12px;
		padding-right: 12px;
		margin-bottom: 14px;
	}

	.input-icon {
		font-size: 14px;
		color: #67C23A;
		width: 44px;
	}

	.input-box {
		flex: 1;
		height: 46px;
		font-size: 15px;
		color: #303133;
	}

	.ph {
		color: #C0C4CC;
	}

	.login-btn {
		height: 46px;
		border-radius: 23px;
		align-items: center;
		justify-content: center;
		margin-top: 8px;
	}

	.login-btn-on {
		background-color: #67C23A;
	}

	.login-btn-off {
		background-color: #B8DFA4;
	}

	.login-btn-text {
		color: #FFFFFF;
		font-size: 16px;
		font-weight: bold;
	}

	.form-foot {
		flex-direction: row;
		justify-content: flex-end;
		margin-top: 14px;
	}

	.foot-link {
		font-size: 13px;
		color: #409EFF;
	}

	.server-tip {
		align-items: center;
		margin-top: 24px;
	}

	.server-tip-text {
		font-size: 11px;
		color: #909399;
		margin-top: 2px;
	}
</style>
