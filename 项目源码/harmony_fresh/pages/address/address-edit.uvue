<template>
	<view class="edit-root">
		<view class="form-card">
			<view class="field">
				<text class="field-label">收货人</text>
				<input class="field-input" v-model="receiver" placeholder="请输入收货人姓名" placeholder-class="ph" :maxlength="20" />
			</view>

			<view class="field">
				<text class="field-label">手机号码</text>
				<input class="field-input" v-model="phone" type="number" placeholder="请输入 11 位手机号" placeholder-class="ph" :maxlength="11" />
			</view>

			<view class="field field-col">
				<text class="field-label">详细地址</text>
				<textarea class="field-textarea" v-model="address" placeholder="省 / 市 / 区 / 街道门牌号" placeholder-class="ph" :maxlength="100" />
			</view>
		</view>

		<view class="tips-card">
			<text class="tips-text">· 收货地址将用于订单配送，请填写准确的楼栋门牌信息</text>
			<text class="tips-text">· 下单后商家发货前仍可在订单详情中修改</text>
		</view>

		<view class="save-btn" @click="save">
			<text class="save-text">{{ saving ? '保存中...' : (isEdit ? '保存修改' : '保存并使用') }}</text>
		</view>

		<view v-if="isEdit" class="del-btn" @click="confirmDelete">
			<text class="del-text">删除该地址</text>
		</view>

		<view class="safe-bottom" />
	</view>
</template>

<script setup lang="uts">
	import { apiAddressDetail, apiAddAddress, apiUpdateAddress, apiDeleteAddress } from '../../utils/api.uts'
	import { getUserId, requireLogin } from '../../utils/config.uts'
	import type { Address } from '../../utils/model.uts'

	const addressId = ref(0)
	const receiver = ref('')
	const phone = ref('')
	const address = ref('')
	const saving = ref(false)

	const isEdit = computed((): boolean => {
		return addressId.value > 0
	})

	onLoad((options : OnLoadOptions) => {
		const id = options['id'] as string | null
		if (id != null && id.length > 0) {
			addressId.value = parseInt(id)
		}
		if (addressId.value > 0) {
			loadDetail()
		}
	})

	async function loadDetail() : Promise<void> {
		try {
			const a = await apiAddressDetail(addressId.value)
			if (a != null) {
				receiver.value = a.receiver == null ? '' : a.receiver
				phone.value = a.phone
				address.value = a.address
			}
		} catch (e) {
		}
	}

	async function save() : Promise<void> {
		if (saving.value) {
			return
		}
		if (!requireLogin()) {
			return
		}
		if (receiver.value.trim().length == 0) {
			uni.showToast({ title: '请输入收货人', icon: 'none' })
			return
		}
		if (phone.value.trim().length != 11) {
			uni.showToast({ title: '请输入 11 位手机号', icon: 'none' })
			return
		}
		if (address.value.trim().length < 5) {
			uni.showToast({ title: '详细地址太短了', icon: 'none' })
			return
		}

		saving.value = true
		try {
			if (isEdit.value) {
				await apiUpdateAddress(addressId.value, getUserId(), receiver.value.trim(), phone.value.trim(), address.value.trim())
				uni.showToast({ title: '修改成功', icon: 'success' })
			} else {
				const created = await apiAddAddress(getUserId(), receiver.value.trim(), phone.value.trim(), address.value.trim())
				if (created != null) {
					// 新增后自动作为本次下单的收货地址
					uni.setStorageSync('selectedAddressId', created.id.toString())
				}
				uni.showToast({ title: '添加成功', icon: 'success' })
			}
			setTimeout(() => {
				uni.navigateBack()
			}, 700)
		} catch (e) {
		} finally {
			saving.value = false
		}
	}

	function confirmDelete() : void {
		uni.showModal({
			title: '删除地址',
			content: '确定删除该收货地址吗？',
			success: (res) => {
				if (res.confirm) {
					doDelete()
				}
			}
		})
	}

	async function doDelete() : Promise<void> {
		try {
			await apiDeleteAddress(addressId.value)
			uni.showToast({ title: '已删除', icon: 'success' })
			setTimeout(() => {
				uni.navigateBack()
			}, 700)
		} catch (e) {
		}
	}
</script>

<style>
	.edit-root {
		flex: 1;
		background-color: #F4F6F3;
		padding: 10px;
	}

	.form-card {
		background-color: #FFFFFF;
		border-radius: 12px;
		padding: 6px 12px;
	}

	.field {
		flex-direction: row;
		align-items: center;
		padding-top: 12px;
		padding-bottom: 12px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #F2F3F5;
	}

	.field-col {
		flex-direction: column;
		align-items: flex-start;
	}

	.field-label {
		width: 76px;
		font-size: 14px;
		color: #606266;
	}

	.field-input {
		flex: 1;
		height: 30px;
		font-size: 14px;
		color: #303133;
	}

	.field-textarea {
		width: 100%;
		height: 64px;
		font-size: 14px;
		color: #303133;
		margin-top: 8px;
	}

	.ph {
		color: #C0C4CC;
	}

	.tips-card {
		padding: 12px 4px;
	}

	.tips-text {
		font-size: 11px;
		color: #909399;
		margin-top: 2px;
	}

	.save-btn {
		height: 44px;
		border-radius: 22px;
		background-color: #67C23A;
		align-items: center;
		justify-content: center;
		margin-top: 8px;
	}

	.save-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: bold;
	}

	.del-btn {
		height: 42px;
		border-radius: 21px;
		background-color: #FFFFFF;
		align-items: center;
		justify-content: center;
		margin-top: 12px;
	}

	.del-text {
		font-size: 15px;
		color: #F56C6C;
	}
</style>
