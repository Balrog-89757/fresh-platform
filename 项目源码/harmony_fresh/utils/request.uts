/**
 * 网络请求封装
 *
 * 后端统一响应格式： { "code": "0", "msg": "成功", "data": ... }
 * - code == "0" 表示成功，resolve(data)
 * - 其它 code 表示业务失败，toast 提示并 reject
 *
 * 认证：后端 JwtInterceptor 从请求头 token 读取 JWT（不是 Authorization: Bearer）
 * 统一路径前缀 /api 由 WebConfig#configurePathMatch 添加
 */

import { getBaseUrl, clearLogin, getToken } from './config.uts'

export type RequestMethod = 'GET' | 'POST' | 'PUT' | 'DELETE'

function toast(msg : string) : void {
	uni.showToast({ title: msg, icon: 'none' })
}

function handleUnauthorized() : void {
	clearLogin()
	toast('登录已过期，请重新登录')
	setTimeout(() => {
		uni.reLaunch({ url: '/pages/login/login' })
	}, 600)
}

/**
 * @param url    以 /api 开头的接口地址，例如 /api/product/page
 * @param method 请求方法
 * @param data   GET 时作为 query 参数，POST/PUT 时作为 JSON body
 */
export function request(
	url : string,
	method : RequestMethod = 'GET',
	data : UTSJSONObject | null = null
) : Promise<any> {
	return new Promise<any>((resolve, reject) => {
		const header = {} as UTSJSONObject
		header['Content-Type'] = 'application/json'
		const token = getToken()
		if (token.length > 0) {
			header['token'] = token
		}

		uni.request({
			url: getBaseUrl() + url,
			method: method,
			data: data,
			header: header,
			timeout: 15000,
			success: (res) => {
				// JwtInterceptor 校验失败时直接返回 401 状态码
				if (res.statusCode == 401) {
					handleUnauthorized()
					reject(new Error('登录已过期'))
					return
				}

				if (res.statusCode != 200) {
					toast('服务异常(' + res.statusCode + ')')
					reject(new Error('HTTP ' + res.statusCode))
					return
				}

				const body = res.data
				if (body == null) {
					toast('服务端无响应')
					reject(new Error('空响应'))
					return
				}

				const result = body as UTSJSONObject
				const code = result['code'] as string | null
				if (code == '0') {
					resolve(result['data'])
					return
				}

				const msg = result['msg'] as string | null
				const text = (msg == null || msg.length == 0) ? '请求失败' : msg
				toast(text)
				reject(new Error(text))
			},
			fail: (_err) => {
				toast('网络异常，请检查服务器地址与网络')
				reject(new Error('网络请求失败'))
			}
		})
	})
}

/** 上传文件（头像等场景备用） */
export function uploadFile(
	url : string,
	filePath : string,
	name : string = 'file'
) : Promise<any> {
	return new Promise<any>((resolve, reject) => {
		const header = {} as UTSJSONObject
		const token = getToken()
		if (token.length > 0) {
			header['token'] = token
		}
		uni.uploadFile({
			url: getBaseUrl() + url,
			filePath: filePath,
			name: name,
			header: header,
			success: (res) => {
				const result = JSON.parse(res.data) as UTSJSONObject
				const code = result['code'] as string | null
				if (code == '0') {
					resolve(result['data'])
				} else {
					reject(new Error('上传失败'))
				}
			},
			fail: (_err) => {
				reject(new Error('上传失败'))
			}
		})
	})
}
