/**
 * 默认后端地址（可在「我的」页面运行时修改）
 *
 * - H5（浏览器调试，如 http://localhost:5174/web）：自动使用 http://localhost:1234
 * - App / 鸿蒙 / 模拟器：使用下面的 LAN_BASE_URL
 *     · 真机：填运行后端的电脑局域网 IP（手机与电脑同一 WiFi）
 *     · Android 模拟器：http://10.0.2.2:1234
 *
 * 后端端口见 springboot/src/main/resources/application.properties 中 server.port=1234；
 * 所有 @RestController 由 WebConfig 统一加了 /api 前缀（例如 /api/product/page）。
 */
const LAN_BASE_URL = 'http://192.168.3.215:1234'
const H5_BASE_URL = 'http://localhost:1234'

/** 平台判断结果缓存，避免每次请求都同步读取系统信息 */
let cachedDefaultUrl : string | null = null

/** H5 端直连本机后端；其它平台用局域网地址 */
export function defaultBaseUrl() : string {
	const cached = cachedDefaultUrl
	if (cached != null) {
		return cached
	}
	let url = LAN_BASE_URL
	try {
		const info = uni.getSystemInfoSync()
		const platform = info.uniPlatform
		if (platform == 'web' || platform == 'h5') {
			url = H5_BASE_URL
		}
	} catch (e) {
		// 取不到平台信息时按 App 处理
	}
	cachedDefaultUrl = url
	return url
}

const STORAGE_BASE_URL = 'apiBaseUrl'

/** 去掉结尾多余的 / */
function trimSlash(url: string): string {
	let u = url.trim()
	while (u.length > 1 && u.endsWith('/')) {
		u = u.substring(0, u.length - 1)
	}
	return u
}

/** 读取当前服务器地址（支持在「我的」页面里运行时修改，方便换电脑/换网络调试） */
export function getBaseUrl(): string {
	const custom = uni.getStorageSync(STORAGE_BASE_URL) as string | null
	if (custom != null && custom.length > 0) {
		return trimSlash(custom)
	}
	return defaultBaseUrl()
}

/** 运行时修改服务器地址 */
export function setBaseUrl(url: string): void {
	const u = trimSlash(url)
	if (u.length == 0) {
		uni.removeStorageSync(STORAGE_BASE_URL)
	} else {
		uni.setStorageSync(STORAGE_BASE_URL, u)
	}
}

/**
 * 把后端返回的图片相对路径转为可访问的完整地址。
 * 后端商品图片形如 /img/1738583441855.png，静态映射为 /api/img/**（见 MyInterceptorConfig）。
 */
export function resolveImage(path: string | null): string {
	if (path == null || path.length == 0) {
		return ''
	}
	if (path.startsWith('http://') || path.startsWith('https://')) {
		return path
	}
	if (path.startsWith('/api/')) {
		return getBaseUrl() + path
	}
	if (path.startsWith('/')) {
		return getBaseUrl() + '/api' + path
	}
	return getBaseUrl() + '/api/img/' + path
}

/* ------------------------- 登录态存取 ------------------------- */

/** 读取字符串缓存，未设置时返回空字符串（避免 getStorageSync 返回类型不确定的问题） */
export function getStorageString(key: string): string {
	const v = uni.getStorageSync(key) as string | null
	if (v == null) {
		return ''
	}
	return v
}

export function getToken(): string {
	return getStorageString('token')
}

export function getUserId(): number {
	const raw = getStorageString('userId')
	if (raw.length == 0) {
		return 0
	}
	const n = parseInt(raw)
	return isNaN(n) ? 0 : n
}

export function getUserName(): string {
	return getStorageString('userName')
}

export function getUserRole(): string {
	return getStorageString('userRole')
}

/** 是否已登录（存在 token 与 userId） */
export function isLogin(): boolean {
	return getToken().length > 0 && getUserId() > 0
}

/** 保存登录结果（后端 login 返回 User 对象，含 id / name / role / token） */
export function saveLogin(userId: number, userName: string, role: string, token: string): void {
	uni.setStorageSync('userId', userId.toString())
	uni.setStorageSync('userName', userName)
	uni.setStorageSync('userRole', role)
	uni.setStorageSync('token', token)
}

export function clearLogin(): void {
	uni.removeStorageSync('token')
	uni.removeStorageSync('userId')
	uni.removeStorageSync('userName')
	uni.removeStorageSync('userRole')
}

/** 未登录时统一跳转登录页 */
export function requireLogin(): boolean {
	if (isLogin()) {
		return true
	}
	uni.showToast({ title: '请先登录', icon: 'none' })
	setTimeout(() => {
		uni.navigateTo({ url: '/pages/login/login' })
	}, 400)
	return false
}
